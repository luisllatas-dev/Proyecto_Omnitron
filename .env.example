# ==========================================
# CONFIGURACIÓN GENERAL DEL SISTEMA OMNITRON
# ==========================================

# Puerto público expuesto por el API Gateway (Nginx)
GATEWAY_PORT=8080

# Configuración de MongoDB
MONGO_ROOT_USER=admin
MONGO_ROOT_PASSWORD=adminsecretpassword
MONGO_PORT=27018

# JWT Secret compartido para validación en microservicios
JWT_SECRET=super_secret_omnitron_jwt_key_2026

# Microservicio de Autenticación
AUTH_SERVICE_PORT=4001
AUTH_DB_NAME=omnitron_auth

# Microservicio de Catálogo de Cursos
CATALOG_SERVICE_PORT=4002
CATALOG_DB_NAME=omnitron_catalog

# Microservicio de Órdenes y Pagos
ORDER_SERVICE_PORT=4003
ORDER_DB_NAME=omnitron_orders

# Pasarelas de Pago (credenciales de prueba/sandbox)
PAYPAL_CLIENT_ID=tu_paypal_client_id
PAYPAL_CLIENT_SECRET=tu_paypal_client_secret
PAYPAL_MODE=sandbox

MERCADOPAGO_ACCESS_TOKEN=tu_mercadopago_access_token

IZIPAY_PUBLIC_KEY=tu_izipay_public_key
IZIPAY_HMAC_SHA256=tu_izipay_hmac_key
IZIPAY_SERVER_URL=https://api.micuentaweb.pe
